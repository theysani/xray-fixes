#include "common.h"

struct 	v2p
{
 	float2 	tc0	: TEXCOORD0;	// base
 	float3 	tc1	: TEXCOORD1;	// environment
  	float3	c0	: COLOR0;		// sun
	float  fog	: FOG;
};

float4 weather_params;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
//uniform samplerCUBE 	s_env	;
TextureCube	s_env;		//	Environment for forward rendering

TextureCube	s_env0 :register(t0);		//	Environment for forward rendering
TextureCube	s_env1 :register(t1);		//	Environment for forward rendering

float4 	main	( v2p I )	: SV_Target
{
//	float4	t_base 	= tex2D		(s_base,I.tc0);
//	float4	t_env 	= texCUBE	(s_env,	I.tc1);
	float4	t_base 	= s_base.Sample( smp_base, I.tc0);
	//float4	t_env 	= s_env.Sample( smp_rtlinear, I.tc1);
	
	float3	t_env0 	= s_env0.Sample( smp_rtlinear, I.tc1);
	float3	t_env1 	= s_env1.Sample( smp_rtlinear, I.tc1);

	float3	f_env	= lerp(t_env0, t_env1, weather_params.y);	

	float3 	base 	= lerp		(f_env,t_base,t_base.a);
	float3	light	= I.c0;
	float3	final 	= light*base*2;

	//	Fogging
	final 	= lerp(fog_color, final, I.fog);

	// out
	return  float4	(final.r,final.g,final.b,t_base.a*I.fog*I.fog);
}
