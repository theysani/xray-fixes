#include "common.h"

struct 	v2p
{
 	float2	tc0	: 	TEXCOORD0;	// base
	float4	c	:	COLOR0;		// diffuse
	float	fog	: FOG;	
};


//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main (v2p I) : SV_Target
{
	float4 res = I.c.a * s_base.Sample( smp_base, I.tc0 ).a;
	res.a *= I.fog*I.fog;

	return	res;
}
